# VANS UK Environment Variables
# Copy this to .env and fill in your values.
# On Railway, DATABASE_URL and PORT are injected automatically — do not set them manually.

# ── Database ──────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when you add a Postgres plugin.
# For local dev, set this manually:
DATABASE_URL=postgresql://user:password@localhost:5432/vans_uk

# (Alternatively, Railway also injects these individual components)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=vans_uk

# ── DVLA Vehicle Enquiry Service ──────────────────────────────────────────────
# Apply at: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=your_dvla_api_key_here

# ── National Highways API ─────────────────────────────────────────────────────
# Apply at: https://webtris.highwaysengland.co.uk/api/swagger/ui/index
NATIONAL_HIGHWAYS_API_KEY=your_highways_api_key_here

# ── Transport for London API ──────────────────────────────────────────────────
# Register at: https://api.tfl.gov.uk/
TFL_APP_KEY=your_tfl_app_key_here

# ── SendGrid (email alerts) ───────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@vans-uk.example.com

# ── Twilio (SMS alerts) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# For testing SMS dispatch without a DVLA keeper record:
TEST_SMS_RECIPIENT=+44xxxxxxxxxx

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
