# VANS UK Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vans_uk

# Redis
REDIS_URL=redis://localhost:6379

# National Highways API
HIGHWAYS_API_KEY=your_highways_api_key_here

# Transport for London API
TFL_APP_KEY=your_tfl_app_key_here

# SendGrid (email alerts)
SENDGRID_API_KEY=your_sendgrid_api_key_here
ALERT_FROM_EMAIL=alerts@vans-uk.example.com

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# JWT Secret (API auth)
JWT_SECRET_KEY=change-this-to-a-random-secret

# App Config
APP_ENV=development
LOG_LEVEL=INFO
